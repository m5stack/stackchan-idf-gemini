# Project-build-level Kconfig for stackchan-idf main.
#
# Currently only the Phase 1+2 QR scanner test trigger lives here. Once Phase
# 3 lands (device_ui タブから start_qr_scan を呼ぶ) this entry will be removed
# — it's only a temporary boot-time switch for bring-up.

menu "Stack-chan QR scanner (Phase 1+2 test)"


    config STACKCHAN_ASR_ENABLED
        bool "Enable on-device ASR (esp-sr WakeNet wake word)"
        default n
        help
            [Phase 0] Bring up esp-sr AFE + WakeNet (Japanese wake word
            "Konnichiha ESP") and log internal-RAM headroom. cores3 with
            camera disabled. Requires a "model" partition.

    config STACKCHAN_QR_TEST_AT_BOOT
        bool "Auto-start QR scan ~30 s after boot"
        default n
        depends on STACKCHAN_CAMERA_ENABLED
        help
            Phase 1/2 bring-up only. With this set, app_main spawns a
            single-shot task that waits 30 s (so M5 init, Wi-Fi, BLE, the
            speaker arpeggio, and demo_loop's babble can all stabilise),
            then calls start_qr_scan(board). Decoded payloads end up in the
            serial log under the "qr" tag. Once the Phase 3 device_ui tab
            is in, this option goes away — the user will start/stop the
            scanner from the touchscreen.

endmenu

menu "Stack-chan feature gates"

    # Slim-build switches. Default ON for the full CoreS3 / AtomS3R profile;
    # the AtomS3 (no-PSRAM) sdkconfig flips them OFF to drop everything that
    # needs PSRAM (TLS bounce buffers, large PCM rings, etc.) and still ship
    # avatar + jtts + LED + settings UI from internal RAM.

    config STACKCHAN_CONVERSATION_ENABLED
        bool "Enable realtime AI conversation (OpenAI / Gemini / XiaoZhi)"
        default y
        help
            Pulls in components/conversation (WebSocket + TLS to OpenAI
            Realtime, Gemini Live, or XiaoZhi) and starts main/conversation
            _task at boot. Disable to drop ~80 KB of code + the PSRAM-only
            assistant_pcm ring, suitable for boards with no PSRAM.

    config STACKCHAN_AUDIO_STREAM_ENABLED
        bool "Enable BLE audio streaming sink"
        default y
        help
            main/audio_stream_sink decode-and-play worker. Needs ~2 MiB of
            PSRAM for the PCM ring + raw input buffer; OFF for AtomS3.

    config STACKCHAN_WIFI_AUDIO_ENABLED
        bool "Enable Wi-Fi RTP audio receiver"
        default y
        help
            main/wifi_audio listener (UDP RTP/L16/μ-law/AAC). Allocates a
            multi-second PSRAM jitter ring; OFF for AtomS3.

    config STACKCHAN_DANCE_POC
        bool "Enable dance P0 experiment (audio + servo power-rail test)"
        default n
        help
            main/dance_poc: masking を無効化して melody を鳴らしながらサーボを
            踊らせ、サーボ移動時の突入電流でスピーカー音声がどれだけ劣化するかを
            実機で判定する go/no-go 実験。通常モードの起動末尾で一度走る。
            リリース ビルドでは無効のままにすること。

    config STACKCHAN_ESPNOW_REMOTE_ENABLED
        bool "Enable ESP-NOW remote-control receiver mode"
        default y
        help
            OperationMode::EspNowRemote — receive M5Stack official Stack-chan
            compatible ESP-NOW pose packets (8-byte [id, yaw, pitch, speed,
            laser]) and drive the head servos. Pulls in components/espnow_remote
            (espressif/esp-now) and adds the mode to the on-device / web mode
            picker. WiFi runs on a fixed channel with no AP association, so this
            mode does NOT start httpd / conversation. OFF to drop the esp-now
            dependency from slim builds.


config STACKCHAN_SANO_BENCH
    bool "sanoTTS boot-time benchmark (before BLE / Wi-Fi start)"
    default n
    help
        起動直後 (BLE / Wi-Fi / 会話などを始める前、内部 RAM が最も空いている時点) に
        sanoTTS の重みをロードして固定の 3 文を合成し、RTF と arena の配置を
        ログに出す。技術検証用 (cores3-sano)。通常のビルドでは n。

config STACKCHAN_MIC_TAP_HOST
    string "Mirror conversation-mode mic audio to this host over UDP (debug; empty = off)"
    default ""
    help
        会話モードでサーバーへ送っているマイク音声 (PCM16 / 16 kHz / 40 ms) を、
        指定ホストの UDP 5005 番へもコピーする。tools/mic_tap.py で受けて WAV に
        落とし、実際にマイクに入った声の時刻・レベルをサーバーの文字起こし時刻と
        同じ時計 (機体 ms) で突き合わせるための診断用。通常は空 (無効)。

endmenu

menu "Stack-chan product profile (Gemini customer build)"

    config STACKCHAN_GEMINI_ONLY
        bool "Lock AI provider to Gemini Live"
        default n
        help
            Hide OpenAI / XiaoZhi from every user-facing config surface,
            ignore attempts to select them over BLE / HTTP, and force the
            effective provider to Gemini even if NVS still holds an old
            value. OpenAI / XiaoZhi source stays in the tree. Turn off to
            restore upstream multi-provider behaviour.

    config STACKCHAN_SETTINGS_ENGLISH
        bool "Ship the device settings pages in English"
        default y if STACKCHAN_GEMINI_ONLY
        default n
        help
            Build the self-contained Wi-Fi settings page from the upstream
            Japanese source, then translate the complete injected HTML and
            both inlined JavaScript modules before embedding it. Japanese
            sources remain untouched for upstream / non-Gemini builds. The
            build fails rather than shipping a partially translated page when
            a new Japanese string needs an English catalog entry.

    config STACKCHAN_BOOT_SPLASH
        bool "Show Google Cloud logo at boot"
        default n
        help
            After Board::begin(), draw a Google Cloud logo on the LCD until
            the face render task takes over. Per-board PNGs are embedded
            (CoreS3 320x240, Atom 128x128, StopWatch 466x466).

    config STACKCHAN_BOOT_SPLASH_MS
        int "Minimum boot-splash display time (ms)"
        default 2000
        range 500 5000
        depends on STACKCHAN_BOOT_SPLASH
        help
            Floor on how long the Google Cloud logo stays visible, even if
            the rest of boot finishes earlier. 1500–3000 ms is the intended
            range.

endmenu
